{
  "title": "CHOWTape",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Analog tape model",
        "built on the Jiles-",
        "Atherton magnetic",
        "hysteresis model.",
        "",
        "A port of Jatin",
        "Chowdhury's",
        "AnalogTapeModel.",
        "",
        "Eight knobs on the",
        "first page:",
        "Drive, Saturation,",
        "Bias, Tone, Speed,",
        "Flutter, Chew, Mix.",
        "",
        "Degrade and Output",
        "are not knobs on",
        "that page - jog on",
        "past Mix to reach",
        "them."
      ]
    },
    {
      "title": "The Tape Stage",
      "lines": [
        "Drive",
        " input level into the",
        " hysteresis model.",
        " Higher pushes the",
        " tape harder: more",
        " harmonics, more",
        " compression.",
        "",
        "Saturation",
        " magnetic saturation",
        " of the virtual tape.",
        " LOWER values give",
        " MORE saturation - a",
        " thicker, more",
        " squashed sound.",
        "",
        "Bias",
        " tape bias / width.",
        " Changes how",
        " reversible the",
        " magnetisation is,",
        " and so the harmonic",
        " character of the",
        " distortion."
      ]
    },
    {
      "title": "Tone & Speed",
      "lines": [
        "Tone",
        " tilt EQ before the",
        " tape stage. Centre",
        " is flat; left is",
        " darker and warmer,",
        " right is brighter.",
        "",
        "Speed",
        " tape speed, about",
        " 1 to 50 ips.",
        " Slower rolls off",
        " more top end, like",
        " real tape, and",
        " moves the head bump",
        " resonance down with",
        " it."
      ]
    },
    {
      "title": "Wear & Damage",
      "lines": [
        "Flutter",
        " wow and flutter",
        " together: slow pitch",
        " drift plus faster",
        " modulation, through",
        " a modulated delay.",
        " Uses Ornstein-",
        " Uhlenbeck variance",
        " so it wanders",
        " instead of cycling.",
        " Defaults to 0.",
        "",
        "Chew",
        " physical tape",
        " damage - random",
        " dropouts and",
        " lowpass, as if the",
        " tape were crinkled.",
        " Defaults to 0.",
        "",
        "Degrade",
        " worn, dirty tape.",
        " Adds hiss, closes a",
        " lowpass down toward",
        " 200 Hz and drops up",
        " to 24 dB of level",
        " as you turn it up.",
        " Defaults to 0."
      ]
    },
    {
      "title": "Mix & Output",
      "lines": [
        "Mix",
        " dry / wet blend.",
        " Defaults to fully",
        " wet. Back it off",
        " for parallel tape.",
        "",
        "Output",
        " makeup gain, 0 to",
        " 2x. Centre is",
        " unity - Drive and",
        " Degrade both change",
        " the level, so this",
        " is how you put it",
        " back."
      ]
    },
    {
      "title": "Credits",
      "lines": [
        "Based on",
        "AnalogTapeModel",
        "(CHOW Tape) by Jatin",
        "Chowdhury.",
        "",
        "Hysteresis model from",
        "the DAFx paper",
        "TapeModel_DAFx, at",
        "ccrma.stanford.edu",
        "/~jatin/420/tape/"
      ]
    }
  ]
}
